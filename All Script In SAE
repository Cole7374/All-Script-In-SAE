-- Sekreto ang Key diri (Hidden/Encoded)
local EncryptedKeyBytes = {71, 87, 65, 80, 79, 83, 73, 67, 79, 76, 69}
local function GetSecretKey()
    local chars = {}
    for _, byte in ipairs(EncryptedKeyBytes) do
        table.insert(chars, string.char(byte))
    end
    return table.concat(chars)
end

local FileName = "JohnbertHub_PermanentKey_v2.json"

local function TrimString(str)
    if not str then return "" end
    return (str:gsub("^%s*(.-)%s*$", "%1"))
end

-- Susihon kung naay saved key (Permanent, walay expiration)
local function CheckSavedKey()
    local successCheck, result = pcall(function()
        if not (readfile and writefile and isfile) then return false end
        if isfile(FileName) then
            local decoded = HttpService:JSONDecode(readfile(FileName))
            if decoded and TrimString(decoded.Key) == GetSecretKey() then
                return true 
            end
        end
        return false
    end)
    return successCheck and result
end

-- I-save ang key permanently
local function SaveKeyData()
    pcall(function()
        if writefile then
            local data = {
                Key = GetSecretKey(),
                Status = "Permanent"
            }
            writefile(FileName, HttpService:JSONEncode(data))
        end
    end)
end

