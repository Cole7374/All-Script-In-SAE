local TabPrivateServer = CreateTab("Private Server")
local ServerStatus = AddParagraph(TabPrivateServer, "Server Browser", "Status: Ready to join available servers...")
AddButton(TabPrivateServer, "Join Available Server (Player > 0)", function()
    ServerStatus.TextLabel.Text = "Searching for a valid server..."
    task.spawn(function()
        pcall(function()
            local cursor = ""
            local servers = {}
            repeat
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
                local success, response = pcall(function() return game:HttpGet(url) end)
                if success and response then
                    local data = HttpService:JSONDecode(response)
                    if data and data.data then
                        for _, s in ipairs(data.data) do
                            if s.playing and s.playing > 0 and s.playing < s.maxPlayers and s.id ~= game.JobId then
                                table.insert(servers, s.id)
                            end
                        end
                        cursor = data.nextPageCursor
                    else
                        break
                    end
                else
                    break
                end
            until #servers > 0 or not cursor

            if #servers > 0 then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
            else
                ServerStatus.TextLabel.Text = "No valid servers found."
            end
        end)
    end)
end)

