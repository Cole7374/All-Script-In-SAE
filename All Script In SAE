local FileName = "JohnbertHub_KeyData_v11.json"
local CorrectKey = "GWAPOSICOLE"

-- Helper function to trim extra whitespaces
local function TrimString(str)
    if not str then return "" end
    return (str:gsub("^%s*(.-)%s*$", "%1"))
end

-- Helper function to calculate timestamp up to today's or next day's 10:00 PM (22:00)
local function GetExpiryTimestamp()
    local currentTime = os.time()
    local dateTable = os.date("*t", currentTime)
    
    -- Target 10:00 PM (22:00:00) today
    local targetTable = {
        year = dateTable.year,
        month = dateTable.month,
        day = dateTable.day,
        hour = 22,
        min = 0,
        sec = 0
    }
    local targetTime = os.time(targetTable)
    
    -- If it's already past 10:00 PM today, set expiry to 10:00 PM tomorrow
    if currentTime >= targetTime then
        targetTable.day = targetTable.day + 1
        targetTime = os.time(targetTable)
    end
    
    return targetTime
end

-- Check Saved Key safely
local function CheckSavedKey()
    local successCheck, result = pcall(function()
        if not (readfile and writefile and isfile) then return false end
        if isfile(FileName) then
            local decoded = HttpService:JSONDecode(readfile(FileName))
            if decoded and TrimString(decoded.Key) == CorrectKey then
                local currentTime = os.time()
                -- Check if current time has not passed the 10:00 PM expiration timestamp
                if currentTime < decoded.ExpiryTime then
                    return true
                end
            end
        end
        return false
    end)
    return successCheck and result
end

local function SaveKeyData()
    pcall(function()
        if writefile then
            local expiryTimestamp = GetExpiryTimestamp()
            local data = {
                Key = CorrectKey,
                ExpiryTime = expiryTimestamp
            }
            writefile(FileName, HttpService:JSONEncode(data))
        end
    end)
end

