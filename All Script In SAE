local function UpdateStyles()
    local targetMainTrans = isTransparent and 0.25 or 0.0
    local targetSubTrans = isTransparent and 0.4 or 0.0
    local targetBtnTrans = isTransparent and 0.2 or 0.0
    
    if isAcrylic then
        MainFrame.BackgroundColor3 = Color3.fromRGB(10, 15, 25)
        targetMainTrans = math.clamp(targetMainTrans + 0.15, 0, 0.8)
    else
        MainFrame.BackgroundColor3 = Color3.fromRGB(20, 30, 50)
    end

    MainFrame.BackgroundTransparency = targetMainTrans
    MainStroke.Transparency = isTransparent and 0.2 or 0.0
    
    for _, item in ipairs(uiElementsToUpdate) do
        if item.Type == "Sidebar" or item.Type == "SearchBox" then
            item.Obj.BackgroundTransparency = targetSubTrans
        elseif item.Type == "TabBtn" then
            item.Obj.BackgroundTransparency = targetSubTrans - 0.1
        elseif item.Type == "Paragraph" then
            item.Obj.BackgroundTransparency = targetSubTrans - 0.1
        elseif item.Type == "Button" then
            item.Obj.BackgroundTransparency = targetBtnTrans
        elseif item.Type == "Image" then
            item.Obj.BackgroundTransparency = targetSubTrans
        end
    end
end

local function FadeInMain()
    MainFrame.Visible = true
    local targetMainTrans = isTransparent and 0.25 or 0.0
    if isAcrylic then targetMainTrans = math.clamp(targetMainTrans + 0.15, 0, 0.8) end
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(MainFrame, tweenInfo, {BackgroundTransparency = targetMainTrans}):Play()
    TweenService:Create(MainStroke, tweenInfo, {Transparency = isTransparent and 0.2 or 0.0}):Play()
    for _, desc in ipairs(MainFrame:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then
            TweenService:Create(desc, tweenInfo, {TextTransparency = 0}):Play()
        elseif desc:IsA("ImageLabel") then
            TweenService:Create(desc, tweenInfo, {ImageTransparency = 0}):Play()
        end
    end
end

local function FadeInToggle()
    ToggleButton.Visible = true
    local targetToggleTrans = isTransparent and 0.25 or 0.0
    local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(ToggleButton, tweenInfo, {BackgroundTransparency = targetToggleTrans, ImageTransparency = 0}):Play()
    TweenService:Create(ToggleStroke, tweenInfo, {Transparency = isTransparent and 0.2 or 0.0}):Play()
end

ToggleButton.MouseButton1Click:Connect(function()
    PlayClickSound()
    FadeInMain()
    local hideTween = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(ToggleButton, hideTween, {BackgroundTransparency = 1, ImageTransparency = 1}):Play()
    TweenService:Create(ToggleStroke, hideTween, {Transparency = 1}):Play()
    task.wait(0.3)
    ToggleButton.Visible = false
end)

