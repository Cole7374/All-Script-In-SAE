local CountdownParagraph = SettingsTab:CreateParagraph({Title = "Next Update (Saturday 11:00 PM)", Content = "Calculating time..."})

task.spawn(function()
    while true do
        pcall(function()
            local currentTime = os.time()
            local currentTable = os.date("*t", currentTime)
            
            local daysUntilSaturday = (7 - currentTable.wday) % 7
            
            local targetTable = {
                year = currentTable.year,
                month = currentTable.month,
                day = currentTable.day + daysUntilSaturday,
                hour = 23,
                min = 0,
                sec = 0
            }
            
            local targetTime = os.time(targetTable)
            
            if currentTime >= targetTime then
                targetTime = targetTime + (7 * 24 * 60 * 60)
            end
            
            local diff = targetTime - currentTime
            local days = math.floor(diff / 86400)
            local hours = math.floor((diff % 86400) / 3600)
            local minutes = math.floor((diff % 3600) / 60)
            local seconds = diff % 60
            
            local timeString = string.format("⏳ %d Days, %02d Hours, %02d Mins, %02d Secs left", days, hours, minutes, seconds)
            CountdownParagraph:Set({Title = "Next Update (Saturday 11:00 PM)", Content = timeString})
        end)
        task.wait(1)
    end
end)

