-- Function para sa Discord Leaderboard Webhook sa matag user
local function SendLeaderboardWebhook(title, messageText)
    pcall(function()
        local HttpService = game:GetService("HttpService")
        
        local thumbType = Enum.ThumbnailType.HeadShot
        local thumbSize = Enum.ThumbnailSize.Size420x420
        local content, isReady = Players:GetUserThumbnailAsync(LocalPlayer.UserId, thumbType, thumbSize)
        
        local profileUrl = "https://www.roblox.com/users/" .. tostring(LocalPlayer.UserId) .. "/profile"
        
        local data = {
            ["content"] = "📊 **JOHNBERT HUB - ACTIVE USER LOG**",
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = messageText,
                ["color"] = 65280,
                ["fields"] = {
                    {["name"] = "👤 Username:", ["value"] = LocalPlayer.Name, ["inline"] = true},
                    {["name"] = "🆔 User ID:", ["value"] = tostring(LocalPlayer.UserId), ["inline"] = true},
                    {["name"] = "🎮 Game ID:", ["value"] = tostring(game.PlaceId), ["inline"] = true},
                    {["name"] = "📌 Script Version:", ["value"] = CURRENT_VERSION, ["inline"] = true},
                    {["name"] = "🔗 Profile Link:", ["value"] = "[Click here to view profile](" .. profileUrl .. ")", ["inline"] = false},
                },
                ["thumbnail"] = {
                    ["url"] = content
                },
                ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }}
        }
        
        local requestFunc = syn and syn.request or http_request or request or (http and http.request)
        if requestFunc then
            requestFunc({
                Url = WebhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end
    end)
end

